# Optional. Enables AI-written incident reports through Google Gemini.
# Without it DeepBell writes a built-in template report instead.
GOOGLE_API_KEY=
# Optional. Gemini model used for AI reports.
GEMINI_MODEL=gemini-2.5-flash
# Optional. Set to 1 for a public deployment: the API-key endpoint returns 403, the crash fault
# is disabled and no .env file is read. Set it in the host's environment, not in this file.
PUBLIC_DEMO=
# Optional. Storage locations (defaults: data/, backups/, reports/ and .env in the project root).
DEEPBELL_DATA_DIR=
DEEPBELL_BACKUP_DIR=
DEEPBELL_REPORTS_DIR=
DEEPBELL_ENV_FILE=
# Optional. Set to 0 to skip the startup seed data (warm-up telemetry, sample transactions,
# example report).
DEEPBELL_SEED=
# Optional. CPU cores available to the app, used to scale the CPU percentage. Detected from the
# container's cgroup quota when empty.
DEEPBELL_CPU_CORES=
# Optional. Set to 1 to skip the background threads (the test suite does this).
DEEPBELL_DISABLE_WORKERS=
# Optional. Address and port for run_all.py (defaults: 127.0.0.1 and 8000).
HOST=
PORT=
