# Optional. Enables AI-written incident reports through Google Gemini.
# Without it DeepBell writes a built-in template report instead.
GOOGLE_API_KEY=
# Optional. Gemini model used for AI reports.
GEMINI_MODEL=gemini-2.5-flash
# Optional. Storage locations (defaults: data/, backups/, reports/ and .env in the project root).
DEEPBELL_DATA_DIR=
DEEPBELL_BACKUP_DIR=
DEEPBELL_REPORTS_DIR=
DEEPBELL_ENV_FILE=
# Optional. Set to 1 to skip the background threads (the test suite does this).
DEEPBELL_DISABLE_WORKERS=
